<Window x:Class="StockMini.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StockMini - 미니 재고 관리" Height="500" Width="700">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button Content="+ 품목추가" DockPanel.Dock="Right" Width="90" Click="AddButton_Click"/>
            <TextBox x:Name="SearchBox" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
        </DockPanel>

        <DataGrid x:Name="ItemGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="카테고리" Binding="{Binding Category}" Width="100"/>
                <DataGridTextColumn Header="수량" Binding="{Binding Quantity}" Width="70"/>
                <DataGridTextColumn Header="단가" Binding="{Binding Price}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="입고" Width="70" Margin="5,0"/>
            <Button Content="출고" Width="70" Margin="5,0"/>
            <Button Content="삭제" Width="70" Margin="5,0"/>
        </StackPanel>
    </Grid>
</Window>