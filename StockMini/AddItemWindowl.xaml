<Window x:Class="StockMini.AddItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="품목 추가" Height="300" Width="300">
    <StackPanel Margin="15">
        <!-- 각 입력 항목: 라벨 + 입력창 -->
        <TextBlock Text="이름"/>
        <TextBox x:Name="NameBox" Margin="0,0,0,10"/>

        <TextBlock Text="카테고리"/>
        <TextBox x:Name="CategoryBox" Margin="0,0,0,10"/>

        <TextBlock Text="수량"/>
        <TextBox x:Name="QuantityBox" Margin="0,0,0,10"/>

        <TextBlock Text="단가"/>
        <TextBox x:Name="PriceBox" Margin="0,0,0,10"/>

        <!-- 저장 버튼: 클릭하면 코드비하인드의 SaveButton_Click 실행 -->
        <Button Content="저장" Click="SaveButton_Click" Height="30" Margin="0,10,0,0"/>
    </StackPanel>
</Window>